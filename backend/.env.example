# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5002

# Database
# Atlas connection string. <PASSWORD> is substituted from MONGO_PASSWORD at boot,
# so you can either inline the password here or keep it in MONGO_PASSWORD.
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@cluster0.example.mongodb.net/e-vote
MONGO_PASSWORD=

# Offline / faster alternative: the workspace Docker Mongo, loaded by `npm run db:restore`
LOCAL_MONGO_URL=mongodb://localhost:27017/e-vote

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_LIFETIME=7d
COOKIE_LIFETIME=7

# Comma-separated list of browser origins allowed to call this API.
# Leave unset to use the built-in defaults (localhost dev ports + the Netlify site).
CORS_ORIGINS=http://localhost:3000,https://evspolls.netlify.app

# Nodemailer (Mailtrap in development)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
